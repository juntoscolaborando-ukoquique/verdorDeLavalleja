# Verdor de Lavalleja — Plantilla de configuración
# Copiar a .env y llenar con los valores reales. Nunca commitear .env.

# GitHub
# Token de acceso personal (PAT) para hacer push al repositorio
GITHUB_TOKEN=

# URL del repositorio en GitHub
GITHUB_REPO=https://github.com/juntoscolaborando-ukoquique/verdorDeLavalleja

# Formulario
# URL del endpoint que procesa los formularios de contacto
# Dejar vacío mientras no esté conectado a un backend real
FORM_ENDPOINT=
